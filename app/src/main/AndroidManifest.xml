<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Android 11+ package visibility: makes coredevices.coreapp's BridgeService resolvable
         so bindService() can reach it (FINAL DESIGN §3.1). -->
    <queries>
        <package android:name="coredevices.coreapp" />
    </queries>

    <!-- The taskerpluginlibrary runner services run as foreground specialUse services
         (declared in the library's merged manifest). FOREGROUND_SERVICE permissions are also
         contributed by the library merge, but are declared here explicitly so the app builds the
         same regardless of merge order. REQUEST_IGNORE_BATTERY_OPTIMIZATIONS is used by the
         onboarding flow (util/BatteryOpt.kt) so push delivery survives Doze. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Post the "Pebble app not connected" warning notification (Android 13+ runtime permission,
         requested in onboarding; best-effort — the in-config warning banner needs no permission). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Populate the "App package" dropdowns (Notification Sent / Notification Action filters, Mute App
         action) with every installed app's name + package. QUERY_ALL_PACKAGES is required on Android
         11+ to enumerate all apps. NOTE: a Play "sensitive" permission — fine for sideloaded/
         self-distributed builds; a Play listing would need a declaration or a narrower <queries>. -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <!-- Preview a custom vibration pattern on the phone from the Send Notification builder. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- IMPORTANT: never set android:sharedUserId — the bridge's consent requires a
         single-package uid (CallerVerifier:43). Setting it breaks consent. (FINAL DESIGN §0 FIX D2) -->
    <application
        android:name=".PebbleTaskerApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.NeonGrid"
        tools:targetApi="31">

        <!-- ════════════════════════════════════════════════════════════════════════════
             LIBRARY PATCHES (FINAL DESIGN §0 FIX C12 / §8)
             taskerpluginlibrary 0.4.10's merged manifest ALREADY declares (verified against the
             library's own src/main/AndroidManifest.xml), on its runner services:
               • IntentServiceAction:    foregroundServiceType="specialUse"
                                         <meta-data name="canBind" value="true"/>  (lets Tasker BIND
                                           the runner under the Android 12+ FGS-from-background rule)
                                         <property PROPERTY_SPECIAL_USE_FGS_SUBTYPE
                                                   value="@string/explanation_for_special_use_action"/>
                                         intent-filter FIRE_SETTING
               • IntentServiceCondition: foregroundServiceType="specialUse"
                                         <property PROPERTY_SPECIAL_USE_FGS_SUBTYPE
                                                   value="@string/explanation_for_special_use_condition"/>
                                         intent-filter QUERY_CONDITION
               • BroadcastReceiverAction    (FIRE_SETTING)
               • BroadcastReceiverCondition (QUERY_CONDITION)
             So PLAN.md "patch (a)/(b)" are satisfied by the merge. The ONLY mandatory app-side step is
             supplying the two justification strings (present in res/values/strings.xml):
               @string/explanation_for_special_use_action
               @string/explanation_for_special_use_condition
             DO NOT hand-declare a <service tools:node="merge"> override unless a post-merge check
             (app/build/intermediates/merged_manifests/.../AndroidManifest.xml) shows specialUse/canBind
             missing — it risks fighting the merge.
             ════════════════════════════════════════════════════════════════════════════ -->

