        <!-- ── Reverse-bind liveness anchor ──────────────────────────────────────────────
             The Pebble app binds this (BIND_AUTO_CREATE) while a watch is connected to revive + keep
             this plugin process alive so events keep flowing to Tasker — no foreground service /
             notification. Exported with NO permission on purpose: it exposes nothing sensitive and
             auto-accepts any binder; the app side does the trust check (consented + cert-verified).
             The action MUST match KeepAliveService.ACTION_KEEP_ALIVE and the app's <queries> intent. -->
        <service
            android:name=".bridge.KeepAliveService"
            android:exported="true">
            <intent-filter>
                <action android:name="coredevices.coreapp.automation.KEEP_ALIVE" />
            </intent-filter>
        </service>

