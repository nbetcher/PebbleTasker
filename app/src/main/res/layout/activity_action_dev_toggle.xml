<?xml version="1.0" encoding="utf-8"?>
<!--
  A17 Toggle Developer Connection config (FINAL DESIGN §2.3, DANGEROUS tier).
  Fields: serial, enable (segmented On/Off/Toggle writing into editEnable, which stays editable so a
  %var works), transport. The editEnable field is the source of truth (%var-capable); the toggle is a
  convenience that detaches when the field holds a %var.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.NeonGrid.CardView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/act_dev_toggle_title"
                    android:textAppearance="@style/TextAppearance.NeonGrid.TitleMedium" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="12dp"
                    android:text="@string/act_dev_toggle_desc"
                    android:textAppearance="@style/TextAppearance.NeonGrid.BodySmall"
                    android:textColor="@color/ng_text_secondary" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutSerial"
                    style="@style/Widget.NeonGrid.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/lbl_serial">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editSerial"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:imeOptions="actionNext"
                        android:inputType="text"
                        android:maxLines="1" />

                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/lbl_enable"
                    android:textAppearance="@style/TextAppearance.NeonGrid.LabelMedium"
                    android:textColor="@color/ng_text_secondary" />

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/toggleEnable"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    app:singleSelection="true"
                    app:selectionRequired="false">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnEnableOn"
                        style="@style/Widget.NeonGrid.Button.Segmented"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/opt_enable_on" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnEnableOff"
                        style="@style/Widget.NeonGrid.Button.Segmented"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/opt_enable_off" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnEnableToggle"
                        style="@style/Widget.NeonGrid.Button.Segmented"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/opt_enable_toggle" />

                </com.google.android.material.button.MaterialButtonToggleGroup>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutEnable"
                    style="@style/Widget.NeonGrid.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="@string/lbl_enable">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editEnable"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:imeOptions="actionNext"
                        android:inputType="text"
                        android:maxLines="1" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutTransport"
                    style="@style/Widget.NeonGrid.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/lbl_transport">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editTransport"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:imeOptions="actionDone"
                        android:inputType="text"
                        android:maxLines="1" />

                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/act_dev_toggle_warn"
                    android:textAppearance="@style/TextAppearance.NeonGrid.LabelSmall"
                    android:textColor="@color/ng_red" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
