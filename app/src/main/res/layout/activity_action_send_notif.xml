<?xml version="1.0" encoding="utf-8"?>
<!--
  A2 Send Watch Notification config (FINAL DESIGN §2.3, headline round-trip action, SENSITIVE).
  Fields: serial, title, body, subtitle, icon, vibe (segmented -> editVibe, %var-capable), actions_json.
  Custom actions you add come back as a Notification Action event (E6) when pressed on the watch.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.NeonGrid.CardView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/act_send_notif_title"
                    android:textAppearance="@style/TextAppearance.NeonGrid.TitleMedium" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="12dp"
                    android:text="@string/act_send_notif_desc"
                    android:textAppearance="@style/TextAppearance.NeonGrid.BodySmall"
                    android:textColor="@color/ng_text_secondary" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutSerial"
                    style="@style/Widget.NeonGrid.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/lbl_serial">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editSerial"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:imeOptions="actionNext"
                        android:inputType="text"
                        android:maxLines="1" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutTitle"
                    style="@style/Widget.NeonGrid.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/lbl_title">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionNext"
                        android:inputType="text"
                        android:maxLines="1" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutBody"
                    style="@style/Widget.NeonGrid.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/lbl_body">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="top|start"
                        android:inputType="textMultiLine"
                        android:minLines="2" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutSubtitle"
                    style="@style/Widget.NeonGrid.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/lbl_subtitle">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editSubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionNext"
                        android:inputType="text"
                        android:maxLines="1" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutIcon"
                    style="@style/Widget.NeonGrid.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/lbl_icon">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editIcon"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:imeOptions="actionNext"
                        android:inputType="text"
                        android:maxLines="1" />

                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/lbl_vibe"
                    android:textAppearance="@style/TextAppearance.NeonGrid.LabelMedium"
                    android:textColor="@color/ng_text_secondary" />

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/toggleVibe"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    app:singleSelection="true"
                    app:selectionRequired="false">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnVibeNone"
                        style="@style/Widget.NeonGrid.Button.Segmented"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/opt_vibe_none" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnVibeShort"
                        style="@style/Widget.NeonGrid.Button.Segmented"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/opt_vibe_short" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnVibeLong"
                        style="@style/Widget.NeonGrid.Button.Segmented"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/opt_vibe_long" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnVibeCustom"
                        style="@style/Widget.NeonGrid.Button.Segmented"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/opt_vibe_custom" />

                </com.google.android.material.button.MaterialButtonToggleGroup>

                <!-- Custom pattern editor: only shown when "Custom" is selected (toggled in code). -->
                <LinearLayout
                    android:id="@+id/customVibeSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/layoutVibe"
                            style="@style/Widget.NeonGrid.TextInputLayout"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="@string/lbl_vibe">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/editVibe"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="monospace"
                                android:imeOptions="actionDone"
                                android:inputType="text"
                                android:maxLines="1" />

                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnVibeBuild"
                            style="@style/Widget.NeonGrid.Button.Tonal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:contentDescription="@string/vibe_build_cd"
                            android:text="@string/vibe_build"
                            app:icon="@drawable/ic_vibe_build" />

                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/vibe_custom_hint"
                        android:textAppearance="@style/TextAppearance.NeonGrid.LabelSmall"
                        android:textColor="@color/ng_text_dim" />

                    <com.nickbether.pebbletasker.ui.widget.VibrationPatternView
                        android:id="@+id/vibePreview"
                        android:layout_width="match_parent"
                        android:layout_height="32dp"
                        android:layout_marginTop="6dp" />

                </LinearLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutActions"
                    style="@style/Widget.NeonGrid.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/lbl_actions_json">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editActions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:gravity="top|start"
                        android:inputType="textMultiLine"
                        android:minLines="2" />

                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/act_send_notif_actions_hint"
                    android:textAppearance="@style/TextAppearance.NeonGrid.LabelSmall"
                    android:textColor="@color/ng_text_dim" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
