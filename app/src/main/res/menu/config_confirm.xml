<?xml version="1.0" encoding="utf-8"?>
<!--
  Toolbar actions shared by every Pebble config activity (PebbleConfigActivity). The check accepts the
  configuration (persist + finish, same as Back); the X discards changes (finish without saving).
-->
<menu xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <item
        android:id="@+id/action_accept"
        android:icon="@drawable/ic_check"
        android:title="@string/cfg_accept"
        app:showAsAction="always" />
    <item
        android:id="@+id/action_discard"
        android:icon="@drawable/ic_close"
        android:title="@string/cfg_discard"
        app:showAsAction="always" />
</menu>
